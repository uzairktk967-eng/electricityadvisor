{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/electricityadvisor/knowledge-base.schema.json",
  "title": "Smart Home Electricity Advisor Knowledge Base",
  "description": "Schema for the versioned JSON knowledge-base files. Application-specific semantic checks must also validate cross-file references.",
  "oneOf": [
    {
      "$ref": "#/$defs/factsFile"
    },
    {
      "$ref": "#/$defs/categoriesFile"
    },
    {
      "$ref": "#/$defs/conclusionsFile"
    },
    {
      "$ref": "#/$defs/recommendationsFile"
    },
    {
      "$ref": "#/$defs/rulesFile"
    }
  ],
  "$defs": {
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
    },
    "factsFile": {
      "type": "object",
      "required": [
        "version",
        "facts"
      ],
      "properties": {
        "version": {
          "$ref": "#/$defs/version"
        },
        "description": {
          "type": "string"
        },
        "facts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "type",
              "description",
              "evidence"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "type": {
                "enum": [
                  "string",
                  "number",
                  "integer",
                  "boolean",
                  "enum"
                ]
              },
              "unit": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "evidence": {
                "enum": [
                  "user_input",
                  "measured",
                  "manufacturer_document",
                  "derived"
                ]
              },
              "minimum": {
                "type": "number"
              },
              "maximum": {
                "type": "number"
              },
              "allowed_values": {
                "type": "array",
                "items": {
                  "type": [
                    "string",
                    "number",
                    "boolean"
                  ]
                }
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "categoriesFile": {
      "type": "object",
      "required": [
        "version",
        "categories"
      ],
      "properties": {
        "version": {
          "$ref": "#/$defs/version"
        },
        "categories": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "label",
              "description"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "label": {
                "type": "string"
              },
              "description": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "conclusionsFile": {
      "type": "object",
      "required": [
        "version",
        "conclusions"
      ],
      "properties": {
        "version": {
          "$ref": "#/$defs/version"
        },
        "conclusions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "category",
              "description",
              "output_type",
              "caveat"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "category": {
                "$ref": "#/$defs/id"
              },
              "description": {
                "type": "string"
              },
              "output_type": {
                "enum": [
                  "boolean",
                  "number",
                  "string",
                  "object"
                ]
              },
              "unit": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "caveat": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "recommendationsFile": {
      "type": "object",
      "required": [
        "version",
        "recommendations"
      ],
      "properties": {
        "version": {
          "$ref": "#/$defs/version"
        },
        "recommendations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "category",
              "text",
              "linked_conclusions",
              "safety_note"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "category": {
                "$ref": "#/$defs/id"
              },
              "text": {
                "type": "string"
              },
              "linked_conclusions": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/id"
                },
                "minItems": 1
              },
              "safety_note": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "rulesFile": {
      "type": "object",
      "required": [
        "version",
        "rule_language_version",
        "evaluation_policy",
        "rules"
      ],
      "properties": {
        "version": {
          "$ref": "#/$defs/version"
        },
        "rule_language_version": {
          "type": "string"
        },
        "evaluation_policy": {
          "type": "object",
          "required": [
            "condition_logic",
            "unknown_policy",
            "rejected_evidence_policy",
            "derived_fact_policy",
            "tie_policy"
          ],
          "properties": {
            "condition_logic": {
              "const": "all"
            },
            "unknown_policy": {
              "const": "unknown_never_matches"
            },
            "rejected_evidence_policy": {
              "const": "rejected_never_matches"
            },
            "derived_fact_policy": {
              "type": "string"
            },
            "tie_policy": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "category",
              "priority",
              "conditions",
              "conclusion",
              "recommendations",
              "explanation",
              "threshold_basis",
              "limitations"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "category": {
                "$ref": "#/$defs/id"
              },
              "priority": {
                "type": "integer"
              },
              "conditions": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "fact",
                    "operator",
                    "value"
                  ],
                  "properties": {
                    "fact": {
                      "$ref": "#/$defs/id"
                    },
                    "operator": {
                      "enum": [
                        "eq",
                        "neq",
                        "gt",
                        "gte",
                        "lt",
                        "lte",
                        "in"
                      ]
                    },
                    "value": {}
                  },
                  "additionalProperties": false
                }
              },
              "requires_conclusion": {
                "$ref": "#/$defs/id"
              },
              "conclusion": {
                "$ref": "#/$defs/id"
              },
              "formula": {
                "type": "string"
              },
              "recommendations": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/id"
                }
              },
              "explanation": {
                "type": "string"
              },
              "threshold_basis": {
                "type": "string"
              },
              "limitations": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  }
}
